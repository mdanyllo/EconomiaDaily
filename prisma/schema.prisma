generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Marketplace {
  AMAZON
  SHOPEE
  MERCADOLIVRE
}

model Promotion {
  id            String      @id @default(uuid())
  externalId    String      @unique // ID do produto no site (evita duplicatas)
  title         String
  price         Float
  image         String?
  url           String      @unique
  affiliateUrl  String
  source        Marketplace
  posted        Boolean     @default(false)
  createdAt     DateTime    @default(now())
}